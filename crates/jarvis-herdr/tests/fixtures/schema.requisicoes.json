      "type",
      "pane_id"
     ],
     "type": "object"
    },
    {
     "properties": {
      "type": {
       "const": "layout.updated",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    }
   ]
