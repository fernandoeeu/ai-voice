{
  "name": "@henriquearthur/ai-voice",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriquearthur/ai-voice.git"
  },
  "keywords": ["mcp", "mcp-server", "alexa", "echo", "tts", "claude", "codex"],
  "bin": {
    "ai-voice": "src/cli.js"
  },
  "files": ["src", "docs"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "MCP server that lets AI agents speak through Amazon Echo devices",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "login": "node src/cli.js login",
    "devices": "node src/cli.js devices",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "alexa-cookie2": "5.0.6",
    "alexa-remote2": "8.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
