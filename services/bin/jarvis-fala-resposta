#!/usr/bin/env -S python3 -I
# Hook Stop do Claude Code: se o turno veio de um pedido por voz (mensagem com "[voz do <nome>]",
# que a Escuta manda) e o Claude não falou nada nele, fala a resposta final no Mac (jarvis-fala, em fila).
# Instalado pelo scripts/setup.sh do repositório Jarvis; ligue-o no ~/.claude/settings.json (veja o README).
import json, os, re, shutil, subprocess, sys

# Marcador que a Escuta põe no começo de cada pedido falado.
VOICE_MARK = os.environ.get("JARVIS_VOZ_MARCADOR") or "[voz do "
CLAUDE = shutil.which("claude") or os.path.expanduser("~/.local/bin/claude")

# O claude -p da reescrita também dispara o Stop: não reentrar.
if os.environ.get("JARVIS_FALA_INNER") or os.environ.get("ALEXA_NOTIFY_INNER"):
    sys.exit(0)
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
path = data.get("transcript_path") or ""
if not os.path.exists(path):
    sys.exit(0)

lines = []
with open(path, encoding="utf-8") as f:
    for line in f:
        try:
            lines.append(json.loads(line))
        except Exception:
            pass

def blocks(entry):
    c = (entry.get("message") or {}).get("content")
    if isinstance(c, str):
        return [{"type": "text", "text": c}]
    return c if isinstance(c, list) else []

# Último pedido digitado ou falado (não resultado de ferramenta).
start = None
for i in range(len(lines) - 1, -1, -1):
    e = lines[i]
    if e.get("type") != "user" or e.get("isMeta"):
        continue
    bs = blocks(e)
    if any(b.get("type") == "tool_result" for b in bs):
        continue
    text = " ".join(b.get("text", "") for b in bs if b.get("type") == "text").strip()
    if not text:
        continue
    start = (i, text)
    break
# Sessões listadas em voz-sempre (uma por linha) falam toda resposta a um pedido do usuário,
# digitado ou falado; avisos automáticos de tarefa não contam como pedido.
def always_speak():
    try:
        with open(os.path.expanduser("~/.local/share/jarvis/voz-sempre"), encoding="utf-8") as f:
            return data.get("session_id", "") in {l.strip() for l in f if l.strip()}
    except OSError:
        return False

if start is None:
    sys.exit(0)
if VOICE_MARK not in start[1]:
    if not always_speak() or "<task-notification>" in start[1] or "SYSTEM NOTIFICATION" in start[1]:
        sys.exit(0)

spoke = False
reply = ""
for e in lines[start[0] + 1:]:
    if e.get("type") != "assistant":
        continue
    for b in blocks(e):
        if b.get("type") == "tool_use":
            name = b.get("name", "")
            cmd = json.dumps(b.get("input", {}))
            if name.endswith("__speak") or "jarvis-fala" in cmd:
                spoke = True
        elif b.get("type") == "text" and b.get("text", "").strip():
            reply = b["text"]
reply = data.get("last_assistant_message") or reply
if spoke or not reply.strip():
    sys.exit(0)

# Texto falável: sem markdown, código ou links, e curto.
t = re.sub(r"```.*?```", " ", reply, flags=re.S)
t = re.sub(r"`([^`]*)`", r"\1", t)
t = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", t)
t = re.sub(r"https?://\S+", "", t)
t = re.sub(r"^\s*\|.*\|\s*$", " ", t, flags=re.M)
t = re.sub(r"[#*_>|]+", " ", t)
t = re.sub(r"^\s*[-•]\s*", "", t, flags=re.M)
t = re.sub(r"\s+", " ", t).strip()
if len(t) > 400:
    cut = t[:400]
    t = cut[: max(cut.rfind(". "), cut.rfind("? "), cut.rfind("! ")) + 1] or cut
# O Haiku reescreve como fala natural em pt-BR (sem inglês nem jargão), em segundo plano.
PROMPT = ("Reescreva o texto abaixo como uma resposta curta (no máximo 3 frases) para ser falada em voz alta, "
          "em português do Brasil natural, em primeira pessoa. Zero palavras em inglês, siglas, nomes de arquivo, "
          "código, links ou nomes de ferramentas: troque termos técnicos por palavras comuns. Não diga quem fala. "
          "Responda só com a fala.")
script = ('t=$(printf %s "$1" | "$3" -p --model haiku --strict-mcp-config "$2" 2>/dev/null '
          "| tr '\\n' ' ' | sed -E 's/[<>`*_#|]//g; s/  +/ /g'); "
          '[ -n "${t// }" ] && exec "$HOME/.local/bin/jarvis-fala" "$t"')
subprocess.Popen(["/bin/zsh", "-c", script, "jarvis", t, PROMPT, CLAUDE],
                 env={**os.environ, "JARVIS_FALA_INNER": "1"},
                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                 start_new_session=True)
