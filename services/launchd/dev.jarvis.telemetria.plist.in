<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo do LaunchAgent da telemetria do Jarvis: sobe o backend Grafana LGTM (Docker/OrbStack) e roda a
     sonda de saúde dos serviços. O services/telemetria/install.sh troca os marcadores entre arrobas e grava
     o resultado em ~/Library/LaunchAgents/dev.jarvis.telemetria.plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.jarvis.telemetria</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BUN@</string>
    <string>@REPO@/packages/telemetry/src/sonda.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@/packages/telemetry</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_OTLP_URL</key><string>http://127.0.0.1:4318</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@DATA@/telemetria/logs/telemetria.out.log</string>
  <key>StandardErrorPath</key><string>@DATA@/telemetria/logs/telemetria.err.log</string>
</dict>
</plist>
