<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo do LaunchAgent do servidor de callback do Grok Bot (jarvis-callback, só em 127.0.0.1).
     Opcional: o scripts/setup.sh só instala com --com-grok. Ele troca os marcadores entre arrobas e grava
     o resultado em ~/Library/LaunchAgents/dev.jarvis.callback.plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.jarvis.callback</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BUN@</string>
    <string>@REPO@/apps/mcp/src/callback-main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@/apps/mcp</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AI_VOICE_ENABLE_SPEECH</key><string>1</string>
    <key>AI_VOICE_OUTPUT</key><string>@AI_VOICE_OUTPUT@</string>
    <key>AI_VOICE_LOCALE</key><string>@AI_VOICE_LOCALE@</string>
    <key>AI_VOICE_AMAZON_PAGE</key><string>@AI_VOICE_AMAZON_PAGE@</string>
    <key>AI_VOICE_DEFAULT_DEVICE</key><string>@AI_VOICE_DEFAULT_DEVICE@</string>
    <key>AI_VOICE_TTS_VOICE</key><string>@AI_VOICE_TTS_VOICE@</string>
    <key>JARVIS_CALLBACK_PORT</key><string>@JARVIS_CALLBACK_PORT@</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@DATA@/callback/logs/callback.out.log</string>
  <key>StandardErrorPath</key><string>@DATA@/callback/logs/callback.err.log</string>
</dict>
</plist>
