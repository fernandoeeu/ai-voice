<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo do LaunchAgent do coletor de telemetria (apps/coletor). O apps/coletor/scripts/instalar.sh
     troca os marcadores entre arrobas e grava ~/Library/LaunchAgents/dev.jarvis.coletor.plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.jarvis.coletor</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BUN@</string>
    <string>@REPO@/apps/coletor/src/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@/apps/coletor</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_OTLP_URL</key><string>http://127.0.0.1:4318</string>
    <key>JARVIS_COLETOR_PORTA</key><string>7352</string>
    <key>JARVIS_HERDR</key><string>@HERDR@</string>
    <key>JARVIS_ESCUTA_EVENTOS</key><string>@DATA@/escuta/logs/escuta.events.jsonl</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@DATA@/coletor/logs/coletor.out.log</string>
  <key>StandardErrorPath</key><string>@DATA@/coletor/logs/coletor.err.log</string>
</dict>
</plist>
