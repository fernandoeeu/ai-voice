# Amazon marketplace the Echo account belongs to.
AI_VOICE_AMAZON_PAGE=amazon.com.br
# Locale used for Alexa speech.
AI_VOICE_LOCALE=pt-BR
# Speech stays off unless this is 1.
AI_VOICE_ENABLE_SPEECH=1
# Serial of the Echo marked as default (see the device list).
AI_VOICE_DEFAULT_DEVICE=
# Optional: where the Amazon session lives (default ~/.local/share/ai-voice).
# AI_VOICE_STATE_DIR=
# Optional: override the Alexa API host.
# AI_VOICE_ALEXA_HOST=
